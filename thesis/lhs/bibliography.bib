@article{SIMAAN1977635,
  title    = {Equilibrium properties of the nash and stackelberg strategies},
  journal  = {Automatica},
  volume   = {13},
  number   = {6},
  pages    = {635-636},
  year     = {1977},
  issn     = {0005-1098},
  doi      = {https://doi.org/10.1016/0005-1098(77)90086-3},
  url      = {https://www.sciencedirect.com/science/article/pii/0005109877900863},
  author   = {M. Simaan},
  keywords = {Decision theory, differential games, game theory, hierarchical systems, optimization, Nash strategies, Stackelberg strategies},
  abstract = {The Nash and Stackelberg strategies of a nonzero sum game have the common property that they are both noncooperative equilibrium solutions for which no player can achieve an improvement in his performance if he attempts to deviate from his strategy (cheat). In this note we show that the Nash solution is desirable only if it is not dominated by any of the Stackelberg solutions. Otherwise a Stackelberg strategy is always more favorable to both players and, as the Nash solution, it can be enforced once an agreement between the players, specifying the leader and the follower, is reached.}
}

