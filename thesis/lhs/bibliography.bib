               and Cybenko, George
               and Liu, Peng
               and Wang, Cliff
               and Wellman, Michael},
  title     = {Empirical Game-Theoretic Methods for Adaptive Cyber-Defense},
  booktitle = {Adversarial and Uncertain Reasoning for Adaptive Cyber Defense: Control- and Game-Theoretic Approaches to Cyber Security},
  year      = {2019},
  publisher = {Springer International Publishing},
